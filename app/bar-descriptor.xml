<?xml version="1.0" encoding="utf-8" standalone="no"?>
<qnx xmlns="http://www.qnx.com/schemas/application/1.0">
    <id>it.berrymaps.app</id>
    <configuration name="Device-Release">
       <entryPointType>Qnx/Cascades</entryPointType>
       <platformArchitecture>armle-v7</platformArchitecture>
       <asset path="arm/o.le-v7/BerryMaps.so" entry="true" type="Qnx/Elf">BerryMaps.so</asset>
    </configuration>
    <name>BerryMaps</name>
    <versionNumber>0.1.0</versionNumber>
    <buildId>25</buildId>
    <description>Mappe Google native per BlackBerry 10.</description>
    <author>BerryMaps</author>
    <cascadesTheme>dark</cascadesTheme>
    <initialWindow>
        <autoOrients>false</autoOrients>
        <systemChrome>none</systemChrome>
    </initialWindow>
    <icon>
        <image>icon.png</image>
    </icon>
    <asset path="icon.png">icon.png</asset>
    <asset path="assets">assets</asset>
    <!-- Places from other apps (PROGETTO.md §24). The Q5 has no BlackBerry Maps
         app and Contacts/Calendar invoke it by name, so BerryMaps takes what is
         sent without a fixed target: shared addresses, geo: URIs, full Google
         Maps links and BB10 map requests. -->
    <invoke-target id="it.berrymaps.app.open">
        <type>APPLICATION</type>
        <invoke-target-name>BerryMaps</invoke-target-name>
        <icon>
            <image>icon.png</image>
        </icon>
        <filter>
            <action>bb.action.OPEN</action>
            <action>bb.action.VIEW</action>
            <mime-type>*</mime-type>
            <property var="uris" value="geo:"/>
        </filter>
        <filter>
            <action>bb.action.OPEN</action>
            <action>bb.action.VIEW</action>
            <mime-type>*</mime-type>
            <property var="uris" value="https://maps.google.,http://maps.google.,https://www.google.com/maps,https://www.google.it/maps,https://google.com/maps,https://maps.app.goo.gl,https://goo.gl/maps"/>
        </filter>
        <filter>
            <action>bb.action.OPEN</action>
            <action>bb.action.VIEW</action>
            <mime-type>application/vnd.rim.map.action-v1</mime-type>
        </filter>
        <filter>
            <action>bb.action.SHARE</action>
            <mime-type>application/vnd.blackberry.string.address</mime-type>
        </filter>
        <filter>
            <action>bb.action.SHARE</action>
            <mime-type>*</mime-type>
            <property var="uris" value="geo:"/>
        </filter>
    </invoke-target>
    <permission system="true">run_native</permission>
    <permission>access_internet</permission>
    <permission>access_location_services</permission>
    <!-- navigation keeps guiding with the app minimized -->
    <permission>run_when_backgrounded</permission>
    <!-- berrymaps.log copy and the API key file live in shared/misc -->
    <permission>access_shared</permission>
    <env var="LD_LIBRARY_PATH" value="app/native/lib:/usr/lib/qt4/lib"/>
</qnx>
